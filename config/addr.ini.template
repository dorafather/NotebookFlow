[INFO]
process=NotebookFlow
version=v1.5.0
#install_hour는 NotebookFlow.exe가 최초 부팅 시 1회만 자동으로 채워줍니다
#(직접 입력하지 마세요 - 값이 있으면 절대 덮어쓰지 않습니다).
#last_applied_version은 "업데이트" 명령으로 공식 저장소 내용을 반영할
#때마다 Claude Code가 자동으로 갱신합니다(직접 입력할 필요 없음 - 비워두면
#첫 자동 확인 때는 조용히 넘어가고, "업데이트"를 한 번이라도 실행하면 그때
#기록됩니다).
last_applied_version=

[RA_ADDRESS]
rag-ra=http://127.0.0.1:8420/rag/search
rag-ra-domain=http://127.0.0.1:8420
llm-ra=http://127.0.0.1:8422/judge
file-ra=http://127.0.0.1:8425/command
file-ra-domain=http://127.0.0.1:8425

[FLOW]
domain=http://127.0.0.1/notebookflow

[RA_SESSION_ID]
file-ra=filera-manager

[FILE]
domain=http://127.0.0.1:8425
cmd_path=/command
telegram_alias=파일

[AGENT]
domain=http://127.0.0.1:8430
cmd_path=/notebookflow/agent/execute
reset_path=/notebookflow/agent/reset
telegram_alias=클루드코드
#agent_name을 비워두면 "클루드코드"는 평범한 Claude로 동작합니다. 설치
#마법사에서 "전용 Claude Code 에이전트 생성"을 선택하면 자동으로
#notebookflow-agent로 채워집니다(직접 값을 넣어 다른 에이전트를 지정해도
#됩니다 - 그 이름의 에이전트가 실제로 등록되어 있어야 합니다, 없는
#이름을 넣으면 "클루드코드" 호출 자체가 실패합니다).
agent_name=

[SSH]
domain=http://127.0.0.1:8450
cmd_path=/notebookflow/ssh/execute

#여러 원격 서버를 등록하려면 [SSH_별칭] 섹션을 원하는 만큼 추가하세요.
#Telegram에서 "텔넷 회사서버 df"처럼 별칭을 붙여 부르면 해당 서버로
#명령이 전달됩니다(별칭 생략 시 [SSH_기본]으로 라우팅됩니다).
[SSH_기본]
host=<여기에 원격 서버 IP 또는 호스트명을 입력하세요>
port=<여기에 SSH 포트를 입력하세요(기본 22)>
username=<여기에 SSH 계정명을 입력하세요>
password=<여기에 SSH 비밀번호를 입력하세요>

[SSH_회사서버]
host=<여기에 원격 서버 IP 또는 호스트명을 입력하세요>
port=<여기에 SSH 포트를 입력하세요(기본 22)>
username=<여기에 SSH 계정명을 입력하세요>
password=<여기에 SSH 비밀번호를 입력하세요>

[SSH_홈서버]
host=<여기에 원격 서버 IP 또는 호스트명을 입력하세요>
port=<여기에 SSH 포트를 입력하세요(기본 22)>
username=<여기에 SSH 계정명을 입력하세요>
password=<여기에 SSH 비밀번호를 입력하세요>

[TELEGRAM]
bot_token=<여기에 Telegram Bot Token을 입력하세요>
my_chat_id=<여기에 본인의 Telegram chat_id를 입력하세요>
domain=https://api.telegram.org
category=알람
message_field=문장.텔레그램응답문장
target_action=텔레그램알람전송

#NOTEBOOKFLOW_BOT은 예외적으로 실제 값이 채워져 있습니다(다른 섹션과
#다르게 개인 계정이 아니라 모든 사용자가 공유하는 공용 커뮤니티 채널이라,
#배포 시점부터 즉시 동작하도록 의도한 것입니다 - CLAUDE.md 1.11절 참고).
[NOTEBOOKFLOW_BOT]
bot_token=8921249532:AAHT3rGqE_t0QHvO2YElOpO1XCsemzsjlAI
community_chat_id=-5308843408
domain=https://api.telegram.org

[NTFY]
topic=<여기에 ntfy 토픽 이름을 입력하세요>
domain=https://ntfy.sh
category=알람
message_field=message
target_action=Ntfy알람전송
telegram_alias=노티파이

[DISCORD]
webhook_url=<여기에 Discord Webhook URL을 입력하세요>
domain=https://discord.com/api
category=알람
message_field=content
target_action=디스코드알람전송
telegram_alias=디스코드

[GITHUB]
token=<여기에 GitHub Personal Access Token을 입력하세요>
domain=https://api.github.com
category=조회
telegram_alias=깃허브

#NotebookFlow 자신의 공식 배포 업데이트 확인/반영 기능 전용 섹션입니다
#(당신 자신의 GitHub 저장소가 아니라 dorafather/NotebookFlow 공식 저장소를
#가리킵니다 - CLAUDE.md 1.15절 참고). GITHUB 섹션과 도메인은 같지만, 이
#기능만의 독립된 STATE 라우팅을 위해 별도 네임스페이스로 분리했습니다.
[UPDATE]
domain=https://api.github.com
telegram_alias=업데이트

[UPDATE_DL]
domain=https://raw.githubusercontent.com

[SLACK]
webhook_url=<여기에 Slack Webhook URL을 입력하세요>
domain=https://hooks.slack.com
category=알람
message_field=text
target_action=슬랙알람전송
telegram_alias=슬랙

[BSKY]
bot_name=<여기에 Bluesky 계정 표시 이름을 입력하세요>
my_id=<여기에 Bluesky 계정 ID(예: name.bsky.social)를 입력하세요>
app_pass=<여기에 Bluesky App Password를 입력하세요>
domain=https://bsky.social
category=알람
message_field=record.text
target_action=sndUpText
telegram_alias=블루스카이

[LINEAR]
api_key=<여기에 Linear API Key를 입력하세요>
domain=https://api.linear.app

[NOTION]
token=<여기에 Notion Integration Token을 입력하세요>
domain=https://api.notion.com

#공공데이터포털(data.go.kr)의 "금융위원회_주식시세정보" API에서 본인
#명의로 발급받은 서비스키가 필요합니다(무료, 개인별 발급 - 이 값을
#다른 사람과 공유하거나 재배포하지 마세요). threshold는 전일 대비
#등락률 알림 기준(%)이며, 비워두면 기본 5%가 적용됩니다.
[KRX]
service_key=<여기에 공공데이터포털에서 발급받은 본인의 서비스키를 입력하세요>
domain=https://apis.data.go.kr/1160100/GetStockSecuritiesInfoService_V2
threshold=5
telegram_alias=주식

#공공데이터포털(data.go.kr)의 "기상청_단기예보 ((구)_동네예보) 조회서비스"
#API에서 본인 명의로 발급받은 서비스키가 필요합니다(무료, 개인별 발급 -
#KRX와 같은 포털이라 서비스키를 공유하는 경우가 많습니다). threshold는
#강수확률 알림 기준(%), alert_hour는 매일 알림을 확인할 시(0~23),
#default_region은 지역을 안 붙이고 "기상청 날씨"만 입력했을 때 쓸
#기본 지역입니다.
[KMA]
service_key=<여기에 공공데이터포털에서 발급받은 본인의 서비스키를 입력하세요>
domain=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
threshold=60
alert_hour=07
default_region=서울
telegram_alias=기상청

[TRACE]
name=TELEGRAM
